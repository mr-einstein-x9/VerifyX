# Database (Docker container mapped to port 5433)
DATABASE_URL=postgresql+asyncpg://verifyx:verifyx_dev_password@localhost:5433/verifyx
TEST_DATABASE_URL=postgresql+asyncpg://verifyx:verifyx_dev_password@localhost:5433/verifyx_test

# Auth & Security
JWT_SECRET=dev_secret_key_change_me_to_at_least_32_bytes_long_random_hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Environment
ENV=development

